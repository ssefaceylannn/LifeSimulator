<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Game Center (giriş, başarımlar, sıralama) ve iCloud (Game Center kayıtlı oyunları iCloud Drive'da tutar).
     Apple Developer › Identifiers › com.hayatsimulatoru.oyun için Game Center ve iCloud (iCloud Documents,
     kapsayıcı iCloud.com.hayatsimulatoru.oyun) açık olmalı. -->
<plist version="1.0">
<dict>
  <key>com.apple.developer.game-center</key>
  <true/>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.com.hayatsimulatoru.oyun</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudDocuments</string>
  </array>
  <key>com.apple.developer.ubiquity-container-identifiers</key>
  <array>
    <string>iCloud.com.hayatsimulatoru.oyun</string>
  </array>
</dict>
</plist>
